{
  "name": "funnel-flow",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsgo --noEmit",
    "seed:core": "npx tsx --env-file .env commands/seed-core/index.ts",
    "seed:groups": "npx tsx --env-file .env commands/seed-groups/index.ts",
    "seed:users": "npx tsx --env-file .env commands/seed-users/index.ts",
    "seed": "npm run seed:core && npm run seed:groups && npm run seed:users"
  },
